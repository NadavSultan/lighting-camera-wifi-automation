{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "CalculationArea": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "classification": {
          "$ref": "#/$defs/CalculationAreaClassification"
        },
        "wgs84_coordinates": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "type": "array"
          },
          "minItems": 4,
          "title": "Wgs84 Coordinates",
          "type": "array"
        },
        "calculation_plane_elevation_m": {
          "default": 0.0,
          "maximum": 10000,
          "minimum": -1000,
          "title": "Calculation Plane Elevation M",
          "type": "number"
        },
        "grid_spacing_m": {
          "default": 2.0,
          "maximum": 1000,
          "minimum": 0.01,
          "title": "Grid Spacing M",
          "type": "number"
        },
        "maintenance_factor": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Maintenance Factor",
          "type": "number"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "modified_at": {
          "format": "date-time",
          "title": "Modified At",
          "type": "string"
        },
        "calculation_state": {
          "$ref": "#/$defs/CalculationAreaState"
        }
      },
      "required": [
        "id",
        "name",
        "classification",
        "wgs84_coordinates"
      ],
      "title": "CalculationArea",
      "type": "object"
    },
    "CalculationAreaClassification": {
      "enum": [
        "ROAD",
        "SIDEWALK",
        "PARKING",
        "OTHER"
      ],
      "title": "CalculationAreaClassification",
      "type": "string"
    },
    "CalculationAreaState": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "default": "not-calculated",
          "enum": [
            "not-calculated",
            "calculated",
            "warning",
            "error"
          ],
          "title": "Status",
          "type": "string"
        },
        "polygon_revision": {
          "default": 1,
          "minimum": 1,
          "title": "Polygon Revision",
          "type": "integer"
        },
        "last_calculated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Calculated At"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "provenance": {
          "additionalProperties": true,
          "title": "Provenance",
          "type": "object"
        }
      },
      "title": "CalculationAreaState",
      "type": "object"
    },
    "CameraFootprintResult": {
      "additionalProperties": false,
      "properties": {
        "pole_id": {
          "title": "Pole Id",
          "type": "string"
        },
        "fixture_model_id": {
          "title": "Fixture Model Id",
          "type": "string"
        },
        "fixture_model_revision": {
          "title": "Fixture Model Revision",
          "type": "integer"
        },
        "mounting_template_revision": {
          "title": "Mounting Template Revision",
          "type": "integer"
        },
        "camera_slot_id": {
          "title": "Camera Slot Id",
          "type": "string"
        },
        "camera_model_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Camera Model Id"
        },
        "camera_model_revision": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Camera Model Revision"
        },
        "lens_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Lens Id"
        },
        "lens_revision": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Lens Revision"
        },
        "horizontal_fov_deg": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Horizontal Fov Deg"
        },
        "vertical_fov_deg": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vertical Fov Deg"
        },
        "fixture_height_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Fixture Height M"
        },
        "fixture_azimuth_deg": {
          "title": "Fixture Azimuth Deg",
          "type": "number"
        },
        "template_relative_azimuth_deg": {
          "title": "Template Relative Azimuth Deg",
          "type": "number"
        },
        "fixed_downward_tilt_deg": {
          "title": "Fixed Downward Tilt Deg",
          "type": "number"
        },
        "camera_absolute_azimuth_deg": {
          "title": "Camera Absolute Azimuth Deg",
          "type": "number"
        },
        "origin_offset_xyz_m": {
          "default": [
            0.0,
            0.0,
            0.0
          ],
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "const": 0.0,
              "type": "number"
            },
            {
              "const": 0.0,
              "type": "number"
            },
            {
              "const": 0.0,
              "type": "number"
            }
          ],
          "title": "Origin Offset Xyz M",
          "type": "array"
        },
        "geometry_contract_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Geometry Contract Version"
        },
        "projected_crs": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Projected Crs"
        },
        "geometry_model_version": {
          "const": "flat-ground-pinhole-1.0.0",
          "default": "flat-ground-pinhole-1.0.0",
          "title": "Geometry Model Version",
          "type": "string"
        },
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "valid": {
          "title": "Valid",
          "type": "boolean"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "projected_coordinates_m": {
          "anyOf": [
            {
              "items": {
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "type": "array"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Projected Coordinates M"
        },
        "wgs84_coordinates": {
          "anyOf": [
            {
              "items": {
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "type": "array"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wgs84 Coordinates"
        },
        "footprint_area_m2": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Footprint Area M2"
        },
        "pixel_density": {
          "$ref": "#/$defs/PixelDensityStatus"
        }
      },
      "required": [
        "pole_id",
        "fixture_model_id",
        "fixture_model_revision",
        "mounting_template_revision",
        "camera_slot_id",
        "camera_model_id",
        "camera_model_revision",
        "lens_id",
        "lens_revision",
        "fixture_height_m",
        "fixture_azimuth_deg",
        "template_relative_azimuth_deg",
        "fixed_downward_tilt_deg",
        "camera_absolute_azimuth_deg",
        "projected_crs",
        "enabled",
        "valid"
      ],
      "title": "CameraFootprintResult",
      "type": "object"
    },
    "CameraGeometryLayer": {
      "additionalProperties": false,
      "properties": {
        "geometry_model_version": {
          "const": "flat-ground-pinhole-1.0.0",
          "default": "flat-ground-pinhole-1.0.0",
          "title": "Geometry Model Version",
          "type": "string"
        },
        "calculated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Calculated At"
        },
        "projected_crs": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Projected Crs"
        },
        "footprints": {
          "items": {
            "$ref": "#/$defs/CameraFootprintResult"
          },
          "title": "Footprints",
          "type": "array"
        },
        "overlaps": {
          "items": {
            "$ref": "#/$defs/CameraOverlapResult"
          },
          "title": "Overlaps",
          "type": "array"
        },
        "priority_area_summaries": {
          "items": {
            "$ref": "#/$defs/PriorityAreaCoverageSummary"
          },
          "title": "Priority Area Summaries",
          "type": "array"
        }
      },
      "title": "CameraGeometryLayer",
      "type": "object"
    },
    "CameraOverlapResult": {
      "additionalProperties": false,
      "properties": {
        "footprint_a": {
          "title": "Footprint A",
          "type": "string"
        },
        "footprint_b": {
          "title": "Footprint B",
          "type": "string"
        },
        "intersection_area_m2": {
          "title": "Intersection Area M2",
          "type": "number"
        },
        "wgs84_coordinates": {
          "items": {
            "items": {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            "type": "array"
          },
          "title": "Wgs84 Coordinates",
          "type": "array"
        }
      },
      "required": [
        "footprint_a",
        "footprint_b",
        "intersection_area_m2"
      ],
      "title": "CameraOverlapResult",
      "type": "object"
    },
    "FixtureType": {
      "enum": [
        "LITE",
        "WIFI",
        "SMART"
      ],
      "title": "FixtureType",
      "type": "string"
    },
    "LayerState": {
      "additionalProperties": false,
      "properties": {
        "original_customer_poles": {
          "default": true,
          "title": "Original Customer Poles",
          "type": "boolean"
        },
        "lite_fixtures": {
          "default": true,
          "title": "Lite Fixtures",
          "type": "boolean"
        },
        "wifi_fixtures": {
          "default": true,
          "title": "Wifi Fixtures",
          "type": "boolean"
        },
        "smart_fixtures": {
          "default": true,
          "title": "Smart Fixtures",
          "type": "boolean"
        },
        "camera_fov": {
          "default": true,
          "title": "Camera Fov",
          "type": "boolean"
        },
        "camera_overlap": {
          "default": true,
          "title": "Camera Overlap",
          "type": "boolean"
        },
        "priority_areas": {
          "default": true,
          "title": "Priority Areas",
          "type": "boolean"
        },
        "wifi_coverage": {
          "default": false,
          "title": "Wifi Coverage",
          "type": "boolean"
        },
        "calculation_areas": {
          "default": true,
          "title": "Calculation Areas",
          "type": "boolean"
        },
        "calculation_points": {
          "default": true,
          "title": "Calculation Points",
          "type": "boolean"
        },
        "lighting_heat_map": {
          "default": true,
          "title": "Lighting Heat Map",
          "type": "boolean"
        },
        "cap_locations": {
          "default": false,
          "title": "Cap Locations",
          "type": "boolean"
        },
        "cap_connections": {
          "default": false,
          "title": "Cap Connections",
          "type": "boolean"
        },
        "warnings": {
          "default": true,
          "title": "Warnings",
          "type": "boolean"
        }
      },
      "title": "LayerState",
      "type": "object"
    },
    "LightingCalculationLayer": {
      "additionalProperties": false,
      "properties": {
        "calculation_model_version": {
          "const": "direct-horizontal-type-c-1.0.0",
          "default": "direct-horizontal-type-c-1.0.0",
          "title": "Calculation Model Version",
          "type": "string"
        },
        "results": {
          "additionalProperties": {
            "$ref": "#/$defs/LightingCalculationResult"
          },
          "title": "Results",
          "type": "object"
        }
      },
      "title": "LightingCalculationLayer",
      "type": "object"
    },
    "LightingCalculationPoint": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "sequence_index": {
          "minimum": 0,
          "title": "Sequence Index",
          "type": "integer"
        },
        "projected_coordinate_m": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Projected Coordinate M",
          "type": "array"
        },
        "wgs84_coordinate": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Wgs84 Coordinate",
          "type": "array"
        },
        "calculation_plane_elevation_m": {
          "title": "Calculation Plane Elevation M",
          "type": "number"
        },
        "maintained_horizontal_illuminance_lux": {
          "minimum": 0,
          "title": "Maintained Horizontal Illuminance Lux",
          "type": "number"
        },
        "per_fixture_contributions_lux": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "number"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Per Fixture Contributions Lux"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "id",
        "sequence_index",
        "projected_coordinate_m",
        "wgs84_coordinate",
        "calculation_plane_elevation_m",
        "maintained_horizontal_illuminance_lux"
      ],
      "title": "LightingCalculationPoint",
      "type": "object"
    },
    "LightingCalculationResult": {
      "additionalProperties": false,
      "properties": {
        "calculation_area_id": {
          "title": "Calculation Area Id",
          "type": "string"
        },
        "calculation_area_name": {
          "title": "Calculation Area Name",
          "type": "string"
        },
        "calculation_model_version": {
          "const": "direct-horizontal-type-c-1.0.0",
          "default": "direct-horizontal-type-c-1.0.0",
          "title": "Calculation Model Version",
          "type": "string"
        },
        "calculated_at": {
          "format": "date-time",
          "title": "Calculated At",
          "type": "string"
        },
        "polygon_revision": {
          "minimum": 1,
          "title": "Polygon Revision",
          "type": "integer"
        },
        "projected_crs": {
          "title": "Projected Crs",
          "type": "string"
        },
        "calculation_input_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Calculation Input Sha256"
        },
        "grid_origin_m": {
          "default": [
            0.0,
            0.0
          ],
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Grid Origin M",
          "type": "array"
        },
        "grid_anchor_policy": {
          "const": "projected-crs-zero-lattice",
          "default": "projected-crs-zero-lattice",
          "title": "Grid Anchor Policy",
          "type": "string"
        },
        "boundary_policy": {
          "const": "inside-or-boundary-with-1e-7-m-tolerance",
          "default": "inside-or-boundary-with-1e-7-m-tolerance",
          "title": "Boundary Policy",
          "type": "string"
        },
        "points": {
          "items": {
            "$ref": "#/$defs/LightingCalculationPoint"
          },
          "title": "Points",
          "type": "array"
        },
        "statistics": {
          "$ref": "#/$defs/LightingStatistics"
        },
        "contributing_fixture_count": {
          "default": 0,
          "minimum": 0,
          "title": "Contributing Fixture Count",
          "type": "integer"
        },
        "fixture_provenance": {
          "items": {
            "$ref": "#/$defs/LightingFixtureProvenance"
          },
          "title": "Fixture Provenance",
          "type": "array"
        },
        "assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "disclaimer": {
          "const": "Not independently validated against AGi32 or another professional photometric reference tool.",
          "default": "Not independently validated against AGi32 or another professional photometric reference tool.",
          "title": "Disclaimer",
          "type": "string"
        }
      },
      "required": [
        "calculation_area_id",
        "calculation_area_name",
        "polygon_revision",
        "projected_crs",
        "statistics"
      ],
      "title": "LightingCalculationResult",
      "type": "object"
    },
    "LightingFixtureProvenance": {
      "additionalProperties": false,
      "properties": {
        "pole_id": {
          "title": "Pole Id",
          "type": "string"
        },
        "fixture_model_id": {
          "title": "Fixture Model Id",
          "type": "string"
        },
        "fixture_model_revision": {
          "title": "Fixture Model Revision",
          "type": "integer"
        },
        "ies_file_id": {
          "title": "Ies File Id",
          "type": "string"
        },
        "ies_file_revision": {
          "title": "Ies File Revision",
          "type": "integer"
        },
        "ies_sha256": {
          "title": "Ies Sha256",
          "type": "string"
        },
        "ies_original_filename": {
          "title": "Ies Original Filename",
          "type": "string"
        },
        "ies_parsed_metadata": {
          "additionalProperties": true,
          "title": "Ies Parsed Metadata",
          "type": "object"
        },
        "mounting_height_m": {
          "title": "Mounting Height M",
          "type": "number"
        },
        "fixture_azimuth_deg": {
          "title": "Fixture Azimuth Deg",
          "type": "number"
        },
        "origin_projected_m": {
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Origin Projected M",
          "type": "array"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "pole_id",
        "fixture_model_id",
        "fixture_model_revision",
        "ies_file_id",
        "ies_file_revision",
        "ies_sha256",
        "ies_original_filename",
        "mounting_height_m",
        "fixture_azimuth_deg",
        "origin_projected_m"
      ],
      "title": "LightingFixtureProvenance",
      "type": "object"
    },
    "LightingStatistics": {
      "additionalProperties": false,
      "properties": {
        "point_count": {
          "default": 0,
          "minimum": 0,
          "title": "Point Count",
          "type": "integer"
        },
        "grid_spacing_m": {
          "title": "Grid Spacing M",
          "type": "number"
        },
        "average_illuminance_lux": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Average Illuminance Lux"
        },
        "minimum_illuminance_lux": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum Illuminance Lux"
        },
        "maximum_illuminance_lux": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum Illuminance Lux"
        },
        "emin_over_eavg": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Emin Over Eavg"
        },
        "emin_over_emax": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Emin Over Emax"
        }
      },
      "required": [
        "grid_spacing_m"
      ],
